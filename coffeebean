    // ================= 2. 感官测试题库 (20题) =================
    // 计分维度：L(明亮度), B(醇厚度), A(香气), S(甜感/温暖), C(复杂度/个性)
    const QUESTIONS = [
        { 
            text: "1. 走在陌生的街上，一阵微风吹过，哪种突然飘来的气味会让你忍不住停下脚步甚至回头寻找？", 
            options: [ 
                { text: "雨后植物的清新与隐约的白花香", scores: { A: 3, L: 2, B: -1 } }, 
                { text: "刚出炉的烘焙麦子与焦糖的甜香", scores: { S: 3, B: 1, L: -1 } }, 
                { text: "潮湿泥土混合着森林古树的木质气息", scores: { C: 3, B: 2, L: -2 } }, 
                { text: "浓郁、微苦又带点霸道的黑巧克力味", scores: { B: 3, C: 2, S: -1 } } 
            ] 
        },
        { 
            text: "2. 如果要为你的独处空间挑选一种常驻气息，你会偏向于？", 
            options: [ 
                { text: "甜美活泼的莓果或柑橘调（明亮跳跃）", scores: { L: 3, A: 1, C: 1 } }, 
                { text: "柔和包容的香草坚果调（温暖安心）", scores: { S: 3, B: 1, C: -2 } }, 
                { text: "沉稳神秘的东方香料调（深邃幽静）", scores: { C: 3, B: 2, L: -1 } }, 
                { text: "干净冷冽的晨露与茶香调（清透自然）", scores: { L: 2, A: 2, B: -2 } } 
            ] 
        },
        { 
            text: "3. 翻开一本泛黄的旧书，你最希望夹在书页里的是什么？", 
            options: [ 
                { text: "一枚风干的酸甜柠檬片或柑橘皮", scores: { L: 3, A: 1 } }, 
                { text: "一片带着余香的玫瑰或茉莉花瓣", scores: { A: 3, L: 1 } }, 
                { text: "一颗烤得微焦的榛果", scores: { S: 2, B: 2, C: -1 } }, 
