    // ================= 3. 逻辑引擎 =================
    let currentQ = 0;
    // 初始值设为中间值
    let userStats = { L: 5, B: 5, A: 5, S: 5, C: 5 }; 
    let historyStack = [];
    
    function start() {
        currentQ = 0;
        userStats = { L: 5, B: 5, A: 5, S: 5, C: 5 }; 
        historyStack = [];
        
        document.getElementById('start-view').classList.add('hidden');
        document.getElementById('result-view').classList.add('hidden');
        document.getElementById('quiz-view').classList.remove('hidden');
        showQ();
    }

   function showQ() {
        if (currentQ >= QUESTIONS.length) {
            calcResult();
            return;
        }

        let prevBtn = document.getElementById('prev-btn');
        if (currentQ === 0) {
            prevBtn.style.display = 'none';
        } else {
            prevBtn.style.display = 'block';
        }
        
        let q = QUESTIONS[currentQ];
        document.getElementById('progress').innerText = `进度 ${currentQ + 1} / ${QUESTIONS.length}`;
        document.getElementById('question-text').innerText = q.text;
        
        let box = document.getElementById('options-box');
        box.innerHTML = '';

        q.options.forEach(opt => {
            let btn = document.createElement('button');
            btn.className = 'btn';
            btn.innerHTML = opt.text; 
            btn.onclick = () => {
                
                historyStack.push({ ...userStats }); 
                
                if (opt.scores) {
                    for (let key in opt.scores) {
                        userStats[key] += opt.scores[key];
                        // 限制分数范围
                        if(userStats[key] > 10) userStats[key] = 10;
                        if(userStats[key] < 0) userStats[key] = 0;
                    }
                }
                currentQ++;
                showQ();
            };
            box.appendChild(btn);
        });
    }

    function prevQ() {
        if (currentQ > 0) {
            currentQ--;
            if (historyStack.length > 0) {
                userStats = historyStack.pop();
            }
            showQ();
        }
    }

    function calcResult() {
        document.getElementById('quiz-view').classList.add('hidden');
        document.getElementById('result-view').classList.remove('hidden');

        // 计算欧几里得距离的平方
        let scoredBeans = BEANS.map(bean => {
            let diff = 
                Math.pow(userStats.L - bean.stats.L, 2) +
                Math.pow(userStats.B - bean.stats.B, 2) +
                Math.pow(userStats.A - bean.stats.A, 2) +
                Math.pow(userStats.S - bean.stats.S, 2) +
                Math.pow(userStats.C - bean.stats.C, 2);
            return { bean: bean, diff: diff };
        });

        scoredBeans.sort((a, b) => a.diff - b.diff);

        let bestBean = null;
        let top1 = scoredBeans[0];
        let top2 = scoredBeans[1];

        // 防撞车随机逻辑
        if (top2 && (top2.diff - top1.diff < 10)) {
            if (Math.random() > 0.6) {
                bestBean = top2.bean; 
            } else {
                bestBean = top1.bean;
            }
        } else {
            bestBean = top1.bean;
        }

        // 显示结果内容
        document.getElementById('bean-name').innerText = bestBean.name;
        
        let tagsContainer = document.getElementById('bean-tags');
        tagsContainer.innerHTML = '';
        bestBean.tags.forEach(tag => {
            let span = document.createElement('span');
            span.className = 'tag';
            span.innerText = tag;
            tagsContainer.appendChild(span);
        });

        document.getElementById('bean-persona').innerText = bestBean.persona;
        document.getElementById('bean-story').innerText = bestBean.story;

        // 调试信息
        document.getElementById('debug-info').innerHTML = 
            `明亮(L):${userStats.L} | 醇厚(B):${userStats.B} | 香气(A):${userStats.A} | 甜暖(S):${userStats.S} | 复杂(C):${userStats.C}`;

        drawRadarChart();
    }
    
    // ================= 4. 雷达图绘制 =================
    let myRadarChart = null;

    function drawRadarChart() {
        const ctx = document.getElementById('radarChart');
        if (!ctx) return;

        if (myRadarChart) {
            myRadarChart.destroy();
        }

        myRadarChart = new Chart(ctx, {
            type: 'radar',
            data: {
                labels: ['明亮/酸度 (L)', '醇厚/触感 (B)', '香气/花香 (A)', '甜感/温暖 (S)', '复杂/个性 (C)'],
                datasets: [{
                    label: '感官偏好',
                    data: [userStats.L, userStats.B, userStats.A, userStats.S, userStats.C],
                    borderColor: 'rgba(139, 69, 19, 0.8)', // 咖啡色边框
                    borderWidth: 2,
                    backgroundColor: 'rgba(210, 105, 30, 0.3)', // 暖橙色填充
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#8b4513',
                    pointRadius: 4,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        angleLines: { color: 'rgba(139, 69, 19, 0.2)' }, 
                        grid: { color: 'rgba(139, 69, 19, 0.1)' },      
                        pointLabels: { 
                            color: '#8b4513', 
                            font: { size: 11, family: "'PingFang SC', sans-serif", weight: 'bold' } 
                        },
                        ticks: { display: false, maxTicksLimit: 5 }, 
                        suggestedMin: 0,
                        suggestedMax: 10
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }
