<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>咖啡豆感官测试</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* --- 样式区域 --- */
        body { font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; background-color: #fcfbf7; color: #5c4033; margin: 0; display: flex; justify-content: center; min-height: 100vh; }
        .container { max-width: 600px; padding: 20px; width: 100%; box-sizing: border-box; }
        .card { background: #fffdf5; border: 2px solid #e0c9a3; border-radius: 12px; padding: 30px; margin-top: 20px; box-shadow: 0 4px 15px rgba(139, 69, 19, 0.1); position: relative; }
        /* 轻微像素/复古感边框装饰 */
        .card::before { content: ''; position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; border: 1px solid rgba(210, 105, 30, 0.3); border-radius: 14px; pointer-events: none; }
        
        h1, h2 { color: #8b4513; text-align: center; margin-top: 0; font-family: 'Courier New', Courier, monospace; /* 轻微印刷感 */ font-weight: bold;}
        .btn { display: block; width: 100%; padding: 16px; margin: 12px 0; background: #faf0e6; color: #5c4033; border: 2px solid #d2b48c; border-radius: 8px; font-size: 15px; cursor: pointer; text-align: left; transition: 0.2s; line-height: 1.4; box-shadow: 2px 2px 0px #d2b48c; font-weight: bold;}
        .btn:hover { background: #ffe4c4; transform: translate(1px, 1px); box-shadow: 1px 1px 0px #d2b48c; }
        .hidden { display: none; }
        
        /* 结果页样式 */
        #result-view { text-align: center; }
        .tag { display: inline-block; background: #f5deb3; padding: 4px 8px; border-radius: 4px; font-size: 12px; color: #8b4513; margin: 2px; border: 1px solid #d2b48c;}
        #debug-info { font-family: monospace; color: #a0522d; font-size: 12px; margin-top: 20px; border-top: 1px dashed #d2b48c; padding-top: 10px; }
        
        /* 装饰元素 */
        .decoration-corner { position: absolute; width: 20px; height: 20px; border: 2px solid #d2b48c; }
        .top-left { top: 10px; left: 10px; border-right: none; border-bottom: none; }
        .top-right { top: 10px; right: 10px; border-left: none; border-bottom: none; }
        .bottom-left { bottom: 10px; left: 10px; border-right: none; border-top: none; }
        .bottom-right { bottom: 10px; right: 10px; border-left: none; border-top: none; }
        
        .coffee-bean-icon { font-size: 24px; text-align: center; margin-bottom: 10px; }
    </style>
</head>
<body>

<div class="container">
    <div id="start-view" class="card">
        <div class="decoration-corner top-left"></div>
        <div class="decoration-corner top-right"></div>
        <div class="decoration-corner bottom-left"></div>
        <div class="decoration-corner bottom-right"></div>
        
        <div class="coffee-bean-icon">☕</div>
        <h1 style="font-size: 28px; letter-spacing: 2px;">测测你是哪种咖啡豆</h1>
        <p style="text-align:center; color:#a0522d; font-size: 14px; margin-bottom: 40px;">如果你是一颗咖啡豆，你会是什么味道？</p>
        
        <button class="btn" style="text-align:center; font-size: 18px; padding: 20px; background: #e0c9a3; border-color: #8b4513; color: #5c4033; box-shadow: 3px 3px 0px #8b4513;" onclick="start()">
            ▶ 开始测试 START
        </button>
    </div>

    <div id="quiz-view" class="card hidden">
        <div style="display:flex; justify-content:space-between; color:#a0522d; font-size:14px; margin-bottom:15px; border-bottom: 1px dashed #d2b48c; padding-bottom: 10px;">
            <span id="progress">进度 1 / 20</span>
            <span>Brewing...</span>
        </div>
        <h2 id="question-text" style="font-size:18px; margin-bottom:30px; font-weight: bold; text-align: left; line-height: 1.5; color: #5c4033;">题目加载中...</h2>
        <div id="options-box"></div>
        
        <button id="prev-btn" class="btn" style="background: transparent; border: 1px dashed #d2b48c; color: #a0522d; margin-top: 20px; font-size: 14px; box-shadow: none; text-align: center;" onclick="prevQ()">
            ↩ 返回上一题
        </button>
    </div>

    <div id="result-view" class="card hidden" style="text-align: center;">
        <p style="color:#a0522d; font-size: 14px; letter-spacing: 1px; margin-bottom: 5px;">你的咖啡豆原型是</p>
        <h1 id="bean-name" style="font-size:32px; margin:10px 0; color: #8b4513; border-bottom: 2px solid #e0c9a3; padding-bottom: 10px; display: inline-block;"></h1>
        
        <div style="margin: 15px 0;">
            <p style="font-size: 14px; color: #a0522d; margin-bottom: 5px; font-weight: bold;">风味指纹</p>
            <div id="bean-tags" style="margin-bottom: 20px;"></div>
        </div>

        <div style="background: #faf0e6; padding: 20px; border-radius: 8px; margin-bottom: 25px; text-align: left; border-left: 4px solid #d2b48c;">
            <h3 style="color: #8b4513; margin: 0 0 10px 0; font-size: 16px;">💬 你的豆设</h3>
            <p id="bean-persona" style="font-size: 14px; line-height: 1.6; color: #5c4033; margin: 0;"></p>
        </div>
        
        <div style="background: #fffdf5; padding: 20px; border-radius: 8px; margin-bottom: 25px; text-align: left; border: 1px dashed #e0c9a3;">
            <h3 style="color: #8b4513; margin: 0 0 10px 0; font-size: 16px;">📖 寻豆师手记</h3>
            <p id="bean-story" style="font-size: 14px; line-height: 1.6; color: #6b4e31; margin: 0;"></p>
        </div>

        <div style="width: 100%; max-width: 400px; height: 250px; margin: 0 auto 30px; position: relative;">
            <canvas id="radarChart"></canvas>
        </div>
        
        <button class="btn" style="text-align:center; background: #e0c9a3; border-color: #8b4513; color: #5c4033; box-shadow: 2px 2px 0px #8b4513;" onclick="location.reload()">↺ 再测一次</button>
        
        <div id="debug-info" style="font-size: 10px; color: #a0522d; margin-top: 10px;"></div>
    </div>

<script>
    // ================= 1. 咖啡豆数据库 (8款) =================
    // 维度定义：
    // L (Lightness/Brightness): 明亮度、酸度、轻盈感。高分代表果酸明亮、轻盈透气；低分代表低酸、沉稳。
    // B (Body/Thickness): 醇厚度、包裹感。高分代表厚重、浓郁、包裹感强；低分代表水感、清爽。
    // A (Aroma/Floral): 香气、花香/茶感。高分代表花香浓郁、嗅觉体验丰富；低分代表偏向基础风味。
    // S (Sweetness/Warmth): 甜感、温暖度。高分代表焦糖/巧克力甜、温暖安心；低分代表清冷、个性。
    // C (Complexity/Wildness): 复杂性、个性/野性。高分代表风味复杂、个性强烈（如酒香、烟熏、泥土）；低分代表干净、平衡、规矩。

    const BEANS = [
        { 
            id: "yirgacheffe", 
            name: "耶加雪菲 (Yirgacheffe)", 
            tags: ["茉莉花香", "柠檬柑橘", "清茶感", "明亮"],
            persona: "内心敏感细腻，有着自己绝对坚持的小世界。", 
            story: "它是咖啡界的“小清新”鼻祖。来自常年雾气弥漫的高地，因为采用了水洗处理，果酸表现得非常干净透亮。生豆小巧紧致，喝起来像是一杯带着高级白花香气的清茶。", 
            stats: { L: 9, B: 3, A: 10, S: 5, C: 4 } 
        },
        { 
            id: "geisha", 
            name: "瑰夏 (Geisha)", 
            tags: ["复合花香", "水蜜桃", "佛手柑", "极高辨识度"],
            persona: "有点招摇、自带气场，一出场就能吸引所有人目光的漂亮家伙。", 
            story: "产量极少、身价高昂的“咖啡界香奈儿”。它极度挑剔高海拔与冷热交替的微气候，豆体像优雅的柳叶。只要喝过一次，你就会被它极具爆发力的香气记住，很难忘记。", 
            stats: { L: 8, B: 4, A: 10, S: 6, C: 8 } 
        },
        { 
            id: "kenya", 
            name: "肯尼亚 AA (Kenya AA)", 
            tags: ["黑莓果汁", "圣女果", "活泼酸质", "多汁饱满"],
            persona: "讲话很直接，爱憎分明、风风火火的行动派。",
            story: "长在1500米以上的红矿土壤里，喝足了阳光。“AA”代表着最高等级的大颗粒饱满豆子。它的酸度一点也不遮掩，喝起来就像在喝一杯浓郁鲜活的莓果汁，非常过瘾。", 
            stats: { L: 10, B: 6, A: 5, S: 4, C: 6 } 
        },
        { 
            id: "bourbon", 
            name: "波旁 (Bourbon)", 
            tags: ["烤花生", "焦糖", "牛奶巧克力", "顺滑微甜"],
            persona: "看起来很好相处，不争不抢，总是默默照顾大家的老好人。", 
            story: "这是奠定经典咖啡味道的基石，也是你平时最常喝到的那个“熟悉的味道”。它酸度极低，带着坚果和焦糖的甜感，像一杯温热的牛奶巧克力，不惊艳但让人觉得舒服又安心。", 
            stats: { L: 2, B: 7, A: 3, S: 9, C: 2 } 
        },
        { 
            id: "mandheling", 
            name: "曼特宁 (Mandheling)", 
            tags: ["森林泥土", "草本香料", "黑巧克力", "醇厚微苦"],
            persona: "沉默寡言、不随波逐流，但办事非常靠谱的实干家。", 
            story: "名字其实是个美丽的误会，源自当地的一个民族。为了应对潮湿的热带雨林气候，咖农发明了“湿刨法”，不仅让生豆长得像羊蹄，更造就了它极高的醇厚度和迷人的微苦，很有力量感。", 
            stats: { L: 1, B: 10, A: 2, S: 3, C: 7 } 
        },
        { 
            id: "bluemountain", 
            name: "蓝山 (Blue Mountain)", 
            tags: ["绝对平衡", "淡淡榛果", "丝滑口感", "温和不突兀"],
