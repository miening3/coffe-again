                { text: "清爽解腻的蜂蜜水或枫糖浆", scores: { L: 2, S: 2, B: -1 } }, 
                { text: "醇香绵长的焦糖酱", scores: { S: 3, B: 2, L: -1 } }, 
                { text: "浓郁热烈的黑糖块", scores: { B: 3, S: 2, C: 1 } }, 
                { text: "我不需要外来的甜，我喜欢苦尽甘来自己的余韵", scores: { C: 3, B: 2, S: -2 } } 
